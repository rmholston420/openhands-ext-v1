# --- Project logs (kept locally, per Space custom instructions) ---
# BUILD_LOG.md, DEBUG_LOG.md, SESSION_HANDOFF.md, PORTING_LEDGER.md are tracked
# Model weights / large artifacts (regenerated by scripts/pull-models.sh)
models/
*.gguf
*.safetensors
*.bin
*.pt
*.onnx

# Vendored source builds (regenerated by scripts/build-*.sh, scripts/vendor-*.sh) — ADR-0003
# Anchored to repo root so directories named 'vendor' elsewhere (e.g. tests/vendor)
# are not accidentally ignored.
/vendor/

# Local data
data/
logs/
*.log

# Bench raw run logs (small JSON summaries under bench/results/ are tracked)
bench/results/*.log
bench/results/*.tmp

# transient DOM-probe scripts (not part of canonical smoke suite)
tests/smoke/probe_*.py
# older smoke iterations (superseded by test_openhands_suite_v3.py)
tests/smoke/test_openhands_suite.py
tests/smoke/test_openhands_suite_v2.py
