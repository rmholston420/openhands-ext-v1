+    def _validate_subtype(cls, data, handler, info):
+        """ADR-0034 override of ``DiscriminatedUnionMixin._validate_subtype``.
+
+        ``LLM`` is a concrete base with subclasses (e.g. ``RouterLLM``,
+        ``CoderPlannerRouter``). The default mixin only dispatches to
+        subclasses when the base is abstract (ABC in bases or an
+        ``@abstractmethod``); its concrete branch asserts that the
+        discriminator matches ``cls.__name__``, which fails on
+        ``LLM.model_validate({..., "kind": "CoderPlannerRouter"})``.
+
+        We can\'t make ``LLM`` abstract without breaking widespread
+        ``LLM(...)`` instantiation in existing user code. Instead, this
+        override adds subclass dispatch on the concrete base while
+        preserving plain-``LLM`` round-trip semantics.
+        """
+        if isinstance(data, cls):
+            return data
+        if isinstance(data, dict):
+            kind = data.get("kind")
+            if kind and kind != cls.__name__:
+                subclass = cls.resolve_kind(kind)
+                data_clean = {k: v for k, v in data.items() if k != "kind"}
+                return subclass.model_validate(data_clean, context=info.context)
+            if kind == cls.__name__:
